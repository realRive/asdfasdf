# Bot-Token aus dem Discord Developer Portal (niemals committen!)
DISCORD_TOKEN=
# Optional: Server-ID, damit Slash-Befehle sofort erscheinen (sonst bis zu 1 h)
GUILD_ID=
# Name der Rolle, die Ergebnisse als Schiedsrichter bestätigen darf
SCHIRI_ROLLE=Schiedsrichter
# Wie viele Schiedsrichter übereinstimmen müssen
BENOETIGTE_BESTAETIGUNGEN=2
# Zeit für Einspruch nach einem vorläufigen Ergebnis
EINSPRUCHSFRIST_MINUTEN=10
DB_PFAD=duelle.db
# Lightning-Netzwerk der Invoices: bc (Mainnet), tb (Testnet), bcrt (Regtest)
NETZWERK=bc
# Wie lange eine eingereichte Invoice mindestens noch gültig sein muss
MIN_RESTLAUFZEIT_MINUTEN=10
# Mindest-CLTV-Delta der Invoice in Blöcken (~10 Min. pro Block); bestimmt, wie lange
# eine Zahlung gesperrt bleiben kann
MIN_CLTV_BLOECKE=40
